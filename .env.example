# PUBLIC — safe in the browser
# Full Project URL, e.g. https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Client production origin, e.g. https://client-domain.com (use http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public store slug mirror
NEXT_PUBLIC_STORE_SLUG=
# Optional: enable Supabase image transforms when your plan supports them
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=true
# Optional: register PWA service worker during local development
# NEXT_PUBLIC_ENABLE_SW_DEV=1

# -------------------------------------------------------------------------
# SERVER — never use NEXT_PUBLIC_ for these; never commit real values
# -------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Required in production for guest cart HMAC (do not reuse the service role key)
GUEST_CART_SECRET=
# Optional guest cart TTL in days (default 30)
GUEST_CART_TTL_DAYS=30

# Admin URL segment only (NOT a security boundary). Example → /manage-store
ADMIN_ROUTE=manage-store
# Active stores.slug when multiple stores exist (optional for single-store clients)
STORE_SLUG=

# Bootstrap helpers (scripts only — optional)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# STORE_NAME=My Store

# -------------------------------------------------------------------------
# PAYMENTS — required only when enabling Razorpay online checkout
# -------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Webhooks (server-only)
RAZORPAY_WEBHOOK_SECRET=
