# Public (safe to expose in the browser)
# Must be the full Project URL, e.g. https://YOUR_REF.supabase.co (not the bare ref)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Active store slug for this deployment (matches stores.slug). Optional if only one active store exists.
STORE_SLUG=
NEXT_PUBLIC_STORE_SLUG=

# Admin URL segment only (NOT a security boundary). Example: manage-store → /manage-store
ADMIN_ROUTE=manage-store

# Server-only (never expose with NEXT_PUBLIC_ — never commit real values)
SUPABASE_SERVICE_ROLE_KEY=

# Guest cart cookie HMAC secret (falls back to service role key if unset)
GUEST_CART_SECRET=
# Optional soft expiry for guest carts (days, default 30)
GUEST_CART_TTL_DAYS=30

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard → Webhooks (server-only)
RAZORPAY_WEBHOOK_SECRET=
